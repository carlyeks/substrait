  "sql_query": "SELECT o_orderkey, SUM(l_extendedprice*(1-l_discount)) AS revenue, o_orderdate, o_shippriority FROM customer, orders, lineitem WHERE c_mktsegment = 'BUILDING' AND c_custkey = o_custkey AND l_orderkey = o_orderkey GROUP BY o_orderkey, o_orderdate, o_shippriority ORDER BY revenue DESC LIMIT 10"
}